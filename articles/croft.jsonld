    {
      "@id": "ko:concept/terminal-based-code-editor",
      "@type": "ko:Concept",
      "prefLabel": "Terminal-based Code Editor",
      "altLabel": [
        "terminal editor",
        "TUI editor"
      ],
      "definition": "A code editor that runs entirely in the terminal, mimicking the interface and features of popular IDEs like VS Code.",
      "domain": "software development"
    },
    {
