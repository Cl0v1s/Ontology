        "ko:concept/c99",
        "ko:concept/syscalls",
        "ko:concept/portable-libraries",
        "ko:concept/single-header-library"
      ],
      "usesLanguage": [
        "ko:concept/c"
      ]
    },
    {
      "@id": "ko:concept/sp-h",
      "@type": "ko:Concept",
      "prefLabel": "sp.h",
      "altLabel": [
        "sp.h library",
        "C standard library"
      ],
      "definition": "A high-quality, ultra-portable standard library for C that does not depend on libc except when required by the platform.",
      "domain": "software engineering"
    },
    {
