    {
      "@id": "ko:concept/interaction-nets",
      "@type": "ko:Concept",
      "prefLabel": "Interaction Nets (INs)",
      "altLabel": [
        "interaction nets",
        "INs"
      ],
      "definition": "A graph rewriting system that encodes computations in a graph of nodes. It allows for parallelism and captures all computable functions without external machinery like garbage collectors.",
      "domain": "computer science"
    },
    {
      "@id": "ko:concept/graph-rewriting",
